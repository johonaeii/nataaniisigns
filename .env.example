# Copy to .env for local development (`netlify dev` loads it), and set the same
# variables in Netlify: Site configuration > Environment variables.
# Placeholders only. Never commit real values. .env is git-ignored.

# --- Browser-visible (embedded in the built site; NOT secret) -----------------
# Supabase > Project Settings > API. The anon key or the newer "publishable" key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Show the "Pay online" option. Leave false until Stripe is fully set up.
VITE_ONLINE_PAYMENTS_ENABLED=false
# Optional display settings
VITE_SHOP_NAME=Nataanii Signs
VITE_SHOP_TAGLINE=
VITE_MARKET_PICKUP_DETAILS=
VITE_CONTACT_EMAIL=

# --- Server-only secrets (Netlify functions; never prefix with VITE_) ---------
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key or the newer "secret" key. Bypasses RLS; keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Stripe > Developers > API keys. Use a TEST key (sk_test_...).
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` locally, or the webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Live keys (sk_live_...) are refused unless this is exactly "true".
STRIPE_ALLOW_LIVE=false

# Public URL used in Stripe redirects and email links. Netlify sets URL
# automatically in production; set SITE_URL to override (e.g. a custom domain).
SITE_URL=http://localhost:8888

# --- Email (optional; emails are skipped and logged if unset) ----------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Nataanii Signs <orders@yourdomain.com>"
EMAIL_FROM=
# Where new-request and paid-order notifications go.
OWNER_EMAIL=

# --- Reservation policy -------------------------------------------------------
# Minutes an online checkout holds signs (Stripe allows 30-1440). Default 30.
CHECKOUT_HOLD_MINUTES=30
# Auto-cancel UNCONFIRMED pay-later requests after this many hours.
# 0 or empty = never (default). The owner confirms or cancels each request manually.
REQUEST_AUTO_RELEASE_HOURS=0
